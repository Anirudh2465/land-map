# ==============================================================================
# LPMS - Local On-Premise Docker Configuration (100% Offline / Self-Contained)
# ==============================================================================

# Application Port
# Users will access the system at http://<server-ip>:8080
# Change this if port 8080 is already in use on this machine (e.g. 3000, 8088, 80)
APP_PORT=8080

# Database Configuration (connects to local PostGIS container in Docker)
DATABASE_URL=postgresql+psycopg2://lpms_user:lpms_password@db:5432/lpms

# Backend Security
SECRET_KEY=lpms_local_secret_key_change_if_needed
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin Seed Account (created automatically on first boot: admin@lms.com)
ADMIN_PASSWORD=Admin@1234

# MinIO Local Storage Configuration (connects to local MinIO container in Docker)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=lpms_minio_user
MINIO_SECRET_KEY=lpms_minio_password
MINIO_BUCKET=lpms-documents
MINIO_SECURE=false

# Leave SUPABASE_URL empty to ensure 100% offline local mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=geospatial
SUPABASE_PUBLISHABLE_KEY=

# Optional Integrations
GEMINI_API_KEY=
MAPBOX_ACCESS_TOKEN=
VITE_CARTO_API_KEY=
