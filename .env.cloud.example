# ==============================================================================
# LPMS - Cloud Deployment Configuration (Render + Supabase + Vercel)
# ==============================================================================

# Database Configuration (Supabase PostgreSQL connection string)
# Use the Connection Pooling URI (port 6543 or 5432) from Supabase Dashboard -> Project Settings -> Database
DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Backend Security
SECRET_KEY=generate_a_long_random_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin Seed Account (created automatically on first boot: admin@lms.com)
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Supabase Storage & Auth Configuration (Cloud Mode)
# When SUPABASE_URL is provided, LPMS automatically uses Supabase Storage for plot KMLs and documents
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=geospatial
SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-ANON-KEY]

# Optional AI / OCR Integrations
GEMINI_API_KEY=
MAPBOX_ACCESS_TOKEN=
VITE_CARTO_API_KEY=
